  {
    "id": "system.reportCapabilityIssue",
    "schemaVersion": 1,
    "description": "Store a capability issue locally in browser SQLite.",
    "parameters": [
      {
        "name": "capabilityId",
        "description": "Related capability ID, when known.",
        "type": "string",
        "required": false
      },
      {
        "name": "reportType",
        "description": "Type of capability or QA issue.",
        "type": "string",
        "required": true
      },
      {
        "name": "severity",
        "description": "Issue severity.",
        "type": "enum",
        "required": true,
        "values": [
          "info",
          "warning",
          "error"
        ]
      },
      {
        "name": "details",
        "description": "Human-readable issue details.",
        "type": "string",
        "required": true
      },
      {
        "name": "route",
        "description": "Route where the issue occurred.",
        "type": "string",
        "required": false
      }
    ],
    "cliCommand": "run system.reportCapabilityIssue --reportType <reportType> --severity <severity> --details <details>",
    "actionKeyTemplate": [
      "SYSTEM",
      "REPORT",
      "<reportType>",
      "<severity>",
      "<details>",
      "ENTER"
    ],
    "accessibleLabel": "Report a local capability issue",
    "risk": "write",
    "navigatorEnabled": false
  },
